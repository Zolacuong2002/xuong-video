# ─────────────────────────────────────────────────────────────
# XƯỞNG VIDEO — chép file này thành  config.env  rồi sửa
#   copy config.env.mau config.env      (Windows)
# config.env nằm trong .gitignore → không bao giờ bị đẩy lên git.
# Dòng nào không sửa thì máy dùng giá trị mặc định trong cfg.mjs.
# ─────────────────────────────────────────────────────────────

# Cổng chạy local: mở http://localhost:5196
XV_PORT=5196

# ── Kênh của bạn ─────────────────────────────────────────────
# Tên kênh (dùng trong prompt, bản dán YouTube, kho đăng). Tên HIỆN TRÊN SLIDE sửa ở mau/thuong-hieu.css (--ten-kenh).
XV_TEN_KENH=Kênh Của Bạn
# Tiền tố tên file trong kho đăng, chỉ chữ không dấu và gạch nối: Kenh-01.mp4, Kenh-01-Short-1.mp4
XV_TIEN_TO_FILE=Kenh
# Một cụm mô tả ngách + người xem mục tiêu — Claude đọc hai dòng này khi nghiên cứu và viết Shorts
XV_NGACH=tài chính cá nhân của người đi làm
XV_NGUOI_XEM=người đi làm lương 10–40 triệu

# ── Claude chạy bằng gì ───────────────────────────────────────
# cli = dùng CHÍNH Claude Code đang cài trên máy (gói Pro/Max) — KHÔNG cần khoá API (mặc định)
# api = gọi API trực tiếp, phải điền ANTHROPIC_API_KEY, tính tiền theo token
XV_CLAUDE=cli
# Để trống thì tự tìm: PATH → extension VS Code → ~/.local/bin
XV_CLAUDE_BIN=
# Chỉ cần khi XV_CLAUDE=api
ANTHROPIC_API_KEY=

# ── Model theo TỪNG BƯỚC, đổi độc lập ────────────────────────
# Nhận alias haiku | sonnet | opus, hoặc tên đầy đủ (claude-opus-5).
#   01 nghiên cứu  — số liệu sai lan xuống mọi bước sau → opus
#   02 kịch bản    — từng chữ đều phát ra tiếng → opus
#   03 phân cảnh   — chỉ cắt đoạn + tả tranh, bước ngốn hạn mức nhất → sonnet
#   08 tiêu đề     — quyết định có ai bấm vào hay không → opus
#   10 Shorts      → opus
XV_MODEL_NGHIEN_CUU=opus
XV_MODEL_KICH_BAN=opus
XV_MODEL_HINH=sonnet
XV_MODEL_SIEU_DU_LIEU=opus
XV_MODEL_SHORTS=opus

# ── Đọc ngách bằng Apify (tuỳ chọn) ──────────────────────────
# Bước 01 tự tìm video cùng chủ đề đang ăn view để Claude học góc nhìn. 1 = bật, 0 = tắt.
# Gói Apify miễn phí $5/tháng ≈ 1.200 video. Token: apify.com → Settings → Integrations → API token.
XV_NGANH=1
XV_NGANH_SO=12
XV_APIFY_TOKEN=

# ── Shorts cắt từ mỗi video dài ──────────────────────────────
# Số Short mỗi video (0 = tắt) và số tranh dọc vẽ mới cho mỗi Short (~110 neuron/tranh)
XV_SHORTS_SO=3
XV_SHORTS_ANH=2

# ── Giọng đọc ────────────────────────────────────────────────
# vieneu = GIỌNG BẠN nhân bản (VieNeu-TTS v3 Turbo, chạy CPU, miễn phí, Apache 2.0) — mặc định
# edge   = Microsoft neural, miễn phí, cần mạng (pip install edge-tts)
# sapi   = giọng Windows có sẵn, không cần mạng, chất lượng thấp
XV_TTS=vieneu
# Mẫu giọng 5–8 giây, MỘT người nói, không nhạc nền, không vỡ tiếng. Xem giong/README.md
XV_TTS_MAU=giong/mau-giong.wav
XV_TTS_PYTHON=.venv-giong/Scripts/python.exe
# Nhiệt độ: thấp = đọc đều tay hơn, cao = biểu cảm hơn nhưng dễ lệch giọng giữa các đoạn
XV_TTS_NHIET=0.8
# Tăng tốc giọng sau khi đọc (ffmpeg atempo, giữ cao độ). 1.0 = giữ nguyên, 1.08 = nhanh 8%
XV_TTS_NHANH=1.08
# Chỉ dùng khi XV_TTS=edge
XV_TTS_GIONG=vi-VN-NamMinhNeural
XV_TTS_TOC_DO=+8%
# Nhịp đọc THẬT (từ/phút) — máy dùng để tính số từ cho video N phút. Đổi giọng thì đo lại sau video đầu:
#   số từ kịch bản ÷ số phút video thật. Tham khảo: vieneu giọng nhân bản × 1,08 ≈ 215–230; edge +8% ≈ 208
XV_TU_MOI_PHUT=215

# ── Nhạc nền ─────────────────────────────────────────────────
# Tải một bài từ Thư viện âm thanh YouTube, lưu thành nhac/nen.mp3 (xem nhac/README.md). Không có file → không nhạc.
XV_NHAC_NEN=nhac/nen.mp3
# Âm lượng nhạc so với giọng (dB): −18 to hơn, −26 nhỏ hơn
XV_NHAC_DB=-22

# ── Phụ đề ───────────────────────────────────────────────────
# tts = lấy mốc thời gian từ chính engine đọc — khớp tuyệt đối, 0 giây xử lý (vieneu, edge)
XV_PHU_DE=tts
XV_WHISPER_MODEL=small
XV_WHISPER_SCRIPT=

# ── Đường dẫn công cụ ────────────────────────────────────────
XV_MSEDGE=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
XV_FFMPEG=ffmpeg
XV_FFPROBE=ffprobe
XV_PYTHON=python

# ── Khổ video ────────────────────────────────────────────────
XV_RONG=1920
XV_CAO=1080
XV_FPS=30

# ── Hình minh hoạ: Worker Cloudflare (thư mục cf-anh/), miễn phí 10.000 neuron/ngày ──
# Sau khi deploy Worker (xem README), dán URL nó in ra, dạng https://xuong-anh.<ten-tai-khoan>.workers.dev
# Để trống = không vẽ tranh, video toàn slide chữ.
XV_ANH_URL=
# Khoá bí mật do bạn tự đặt, trùng với secret KHOA của Worker: npx wrangler secret put KHOA
XV_ANH_KHOA=
# Số ảnh minh hoạ VẼ MỚI tối đa mỗi video. ~110 neuron/ảnh → 60 ảnh ≈ 6.600 neuron, chừa ~3.000/ngày
# cho thumbnail + Shorts. Hạn mức 10.000 miễn phí/ngày, reset 07:00 sáng giờ Việt Nam.
# Đoạn không được vẽ mới thì dùng lại ảnh gần nhất. Đặt 0 để tắt minh hoạ, quay về slide chữ.
XV_ANH_TOI_DA=60
XV_ANH_SONG=3
# Nhân vật kênh — hai ảnh tham chiếu phải NHỎ HƠN 512px, xem nhan-vat/README.md
XV_ANH_THAM_CHIEU_TOAN_THAN=nhan-vat/chuan/tham-chieu-toan-than.png
XV_ANH_THAM_CHIEU_MAT=nhan-vat/chuan/tham-chieu-mat.png
